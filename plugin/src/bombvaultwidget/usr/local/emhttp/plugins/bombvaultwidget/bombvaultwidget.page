  /* Info icon (house convention): each field's help text hides behind a small
     ⓘ next to its label; the script at the end moves the help HTML into a
     hover/focus bubble. If JS is off the original .bvd-help text stays visible. */
  .bvd-info{display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;
    color:var(--dim2);opacity:.7;cursor:help;flex:none;padding:0;background:none;border:none}
  .bvd-info:hover,.bvd-info:focus{opacity:1;outline:none;color:var(--dim)}
  .bvd-info svg{width:15px;height:15px;display:block}
  .Theme--white .bvd-info,.Theme--azure .bvd-info{color:#8a8a8a}
  .bvd-info-pop{position:absolute;z-index:9999;max-width:300px;background:#1c1c1c;color:#eaeaea;
    border:1px solid rgba(255,255,255,.14);border-radius:8px;padding:9px 11px;
    font:12px/1.5 "Segoe UI",system-ui,sans-serif;box-shadow:0 6px 20px rgba(0,0,0,.5)}
  .bvd-info-pop code{background:rgba(255,255,255,.08);padding:1px 4px;border-radius:4px;font-size:11.5px}

  /* Buttons follow the HOUSE palette, hard-set (style guide): primary action =
     BombVault gold (#f4c63d family, dark text — same accent as BV's own UI),
     secondary = Carbon dark surface with light text. Deliberately NOT Unraid's
     --button/--border theme vars and !important throughout: themes/box-side
     scripts restyle generic buttons (that's where the off-palette green/teal
