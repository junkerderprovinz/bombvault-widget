<?php
/* BombVault Widget settings → writes /boot/config/plugins/bombvaultwidget/
   bombvaultwidget.cfg via Unraid's /update.php. NB: no functions defined in a
   .page (Unraid may include it more than once → "Cannot redeclare" → blank
   page). */
$cfg   = parse_plugin_cfg("bombvaultwidget");
$bvurl = isset($cfg['BV_URL'])       ? $cfg['BV_URL']       : '';
$wtok  = isset($cfg['WIDGET_TOKEN']) ? $cfg['WIDGET_TOKEN'] : '';

/* UI text follows Unraid's language — load this plugin's locale file (English
   base, then overlay the active language; missing keys fall back to English). */
$lang = strtolower(substr((string)(isset($_SESSION['locale']) ? $_SESSION['locale'] : ''), 0, 2));
$langdir = '/usr/local/emhttp/plugins/bombvaultwidget/lang';
$L = json_decode(@file_get_contents("$langdir/en.json"), true) ?: array();
if ($lang !== '' && $lang !== 'en' && is_file("$langdir/$lang.json")) {
  $tr = json_decode(@file_get_contents("$langdir/$lang.json"), true);
  if (is_array($tr)) $L = array_merge($L, $tr);
}
?>

<style>
  /* House look (ShipLog/CC convention): no dark backing sheet — the content
     sits on Unraid's own surface. Borderless flat header, borderless cards set
     apart by a lighter fill + a soft shadow, not a frame. */
  .bvd-cfg{--card:#242424;--txt:#e6e6e6;--dim:#b4b4b4;--dim2:#8a8a8a;
    --line:#333;--line2:#3a3a3a;--inp:#1b1b1b;
    max-width:820px;margin:6px auto 0;color:var(--txt);
    font:14px/1.5 "Segoe UI",system-ui,-apple-system,sans-serif}
