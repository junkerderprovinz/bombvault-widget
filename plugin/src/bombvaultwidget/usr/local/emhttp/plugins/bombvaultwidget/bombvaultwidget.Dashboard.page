Menu="Dashboard:0"
Cond="version_compare(parse_ini_file('/etc/unraid-version')['version'],'6.11.9','>')"
---
<?php
/* BombVault Activity: a native Unraid 7 dashboard tile, listed in tile
 * management like the built-in ones.
 *
 * - The ":0" rank in Menu="Dashboard:0" sorts this page before DashStats,
 *   which builds the tile table; without it the tile is silently dropped.
 *   Cond limits it to 6.12+, the $mytiles dashboard.
 * - The <tbody title> is the tile's identity: tile management shows it as the
 *   label, and md5(title) keys the visibility and position saved in
 *   /boot/config/dashboard_settings.json. Renaming or translating it orphans
 *   the user's saved layout.
 * - The $mytiles key 'bombvaultwidget' must be unique across installed
 *   plugins; 'column2' is only the default column.
 * - This page runs on every dashboard load, so the PHP stays minimal: no curl,
 *   since scripts/bombvaultwidget.js fills the tile from the same-origin proxy,
 *   and no functions, since a .page can be included more than once and a
 *   redeclaration blanks the dashboard.
 * - The first row copies DashStats' header structure (tile-header,
 *   tile-header-left, -right), which Unraid 7's dashboard JS hooks the
 *   collapse chevron and dragging onto.
 */
/* The "Open BombVault" control comes from the flash cfg, a cheap ini read, and
 * is left out while BV_URL is unset or invalid so the tile never shows a dead
 * link. Action controls come first and the cog last, as on native tiles; the
 * dashboard JS appends its chevron after them. */
$bvd_cfg  = parse_plugin_cfg('bombvaultwidget');
$bvd_url  = isset($bvd_cfg['BV_URL']) ? trim($bvd_cfg['BV_URL']) : '';
$bvd_open = '';
if ($bvd_url !== '' && preg_match('#^https?://#i', $bvd_url)) {
  $bvd_open = "<a href='" . htmlspecialchars($bvd_url, ENT_QUOTES) . "' target='_blank' rel='noopener' title='Open BombVault'><i class='fa fa-fw fa-external-link control'></i></a>";
}
$mytiles['bombvaultwidget']['column2'] = <<<EOT
<tbody title="BombVault Activity">
<tr><td><span class='tile-header'><span class='tile-header-left'><i class='icon-log f32'></i><div class='section'><h3 class='tile-header-main'>BombVault Activity</h3></div></span><span class='tile-header-right'><span class='tile-header-right-controls'>{$bvd_open}<a href='/Settings/bombvaultwidget' title="Go to BombVault Widget settings"><i class='fa fa-fw fa-cog control'></i></a></span></span></span></td></tr>
<tr><td class='bvd-td'><div id='bvd-log' class='bvd-log'></div></td></tr>
</tbody>
EOT;
?>
<style>
/* Every dashboard tile is a <tbody> in one shared table, so the nowrap log
   lines would widen the whole column. max-width:0 makes this cell defer to the
   column width; the log fills it and rows keep their one-line ellipsis. */
.bvd-td{max-width:0}
/* The log brings its own dark background, like a terminal, so it reads the
   same on every Unraid theme. box-sizing:border-box keeps the padding inside
   width:100%; with content-box the box renders 24px wider than .bvd-td and
   overlaps the neighbour tile in a narrow column (#137). */
.bvd-log{box-sizing:border-box;width:100%;overflow-x:hidden;height:260px;overflow-y:auto;background:#161616;color:#e0e0e0;
  font-family:Consolas,'Cascadia Mono',Menlo,monospace;font-size:12px;line-height:1.75;
  padding:8px 12px 10px;border-radius:4px;text-align:left;
  scrollbar-width:thin;scrollbar-color:#393939 #161616}
.bvd-log::-webkit-scrollbar{width:8px}
.bvd-log::-webkit-scrollbar-thumb{background:#393939;border-radius:4px}
.bvd-log::-webkit-scrollbar-track{background:#161616}
.bvd-row{display:flex;gap:9px;white-space:nowrap;overflow:hidden}
.bvd-ts{color:#8d8d8d;flex:0 0 auto}
.bvd-g{width:12px;text-align:center;flex:0 0 auto}
.bvd-msg{overflow:hidden;text-overflow:ellipsis}
.bvd-ok{color:#6fdc8c}
.bvd-fail{color:#ff8389}
.bvd-info{color:#78a9ff}
.bvd-idle{color:#f1c21b}
@keyframes bvd-pulse{0%,100%{opacity:1}50%{opacity:.45}}
.bvd-live .bvd-g{animation:bvd-pulse 2s ease-in-out infinite}
</style>
<script src="<?autov('/plugins/bombvaultwidget/scripts/bombvaultwidget.js')?>"></script>
