<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name      "bombvaultwidget">
  <!ENTITY slug      "bombvaultwidget">
  <!ENTITY author    "Junker der Provinz">
  <!ENTITY version   "1.1.1">
  <!ENTITY launch    "Settings/bombvaultwidget">
  <!ENTITY gitURL    "https://raw.githubusercontent.com/junkerderprovinz/bombvault-widget/main/plugin">
  <!ENTITY pluginURL "&gitURL;/&slug;.plg">
  <!ENTITY pkgURL    "https://github.com/junkerderprovinz/bombvault-widget/releases/download/v&version;">
  <!ENTITY emhttp    "/usr/local/emhttp/plugins/&slug;">
  <!ENTITY plgPath   "/boot/config/plugins/&slug;">
  <!ENTITY txz       "&slug;-&version;-x86_64-1.txz">
]>

<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="&launch;"
        pluginURL="&pluginURL;"
        min="6.12.0"
        support="https://github.com/junkerderprovinz/bombvault-widget/issues">

<!-- FanCtrlPlus convention: name is the lowercase slug so Unraid resolves the
     logo (plugins/<slug>/images/<slug>.png) AND the Plugins-tab description
     (plugins/<slug>/README.md). The pretty "BombVault Widget" name comes
     from README.md.
     TODO before publishing: replace the support link with the real forum topic. -->
<ICON>
/usr/local/emhttp/plugins/&slug;/images/&slug;.png
</ICON>

<CHANGES>
Shows BombVault's activity log as a real, native tile on the Unraid 7
dashboard: every backup, restore, verify, prune, off-site replication and
drill as it happens, plus the next scheduled run — in the same dark
terminal-style log as BombVault's own widget. Read-only by construction;
requires BombVault &gt;= 6.9.0 and a widget token.

### 1.1.2
#1 Fresh install no longer fails. The 1.1.1 pre-install step pruned old cached
   packages with `find` over the plugin directory, which does not exist yet on
   a first install, so `find` exited non-zero and Unraid aborted the install
   with "'/bin/bash' returned 1". It now creates the directory first, so a first
   install and an upgrade both proceed.

### 1.1.1
#1 The tile survives a reboot with no network. The pre-install step used to
   wipe the installed files and delete the cached package before downloading
   the new one, so a boot that ran before the network came up left the widget
   gone and unable to reinstall. It now keeps the current package cached on the
   flash and reinstalls from it offline; only stale-version packages are pruned.

### 1.1.0
#1 The tile can no longer widen its dashboard column: the log cell now defers
   to the column width (max-width:0 table trick) and the log box clips inside
   it — long lines keep their single-row ellipsis, no horizontal scrollbar,
   the two-column layout stays intact on every theme.
#2 The widget-token field now accepts BombVault's full widget URL: paste
   http(s)://host:port/widget?token=... and the token part is extracted
   automatically on Apply (and tolerated server-side for values saved
   earlier). Field hint updated in all 26 languages.
#3 New "Open BombVault" control on the tile header — an external-link icon
   next to the settings cog that jumps straight to your BombVault WebUI in a
   new tab; hidden while no URL is configured.

### 1.0.0
#1 Initial build: a native dashboard tile "BombVault Activity" (it appears in
   the dashboard's tile-management list and supports hide/move/collapse like
   the built-in tiles), fed via a same-origin PHP proxy — the widget token
   never reaches the browser. Line composition mirrors BombVault's own
   embeddable widget one-to-one. Settings under Settings -&gt; Utilities with a
   Test-connection button, localised across the 26 supported languages.
</CHANGES>

<!-- Pre-install: prune ONLY stale-version packages, keep the CURRENT one cached.
     Do NOT wipe the installed dir here and do NOT delete the current .txz: on a
     reboot Unraid reinstalls each .plg, and if the boot happens before the
     network is up, a re-download fails — leaving the plugin GONE if we already
     removed the working files and the cached package (real incident 2026-07-26).
     Keeping &txz; on the flash lets the boot reinstall from cache with no
     network at all. The reinstalling upgradepkg step below already removes
     files the old package had and the new one drops, so no manual orphan wipe
     is needed. The .cfg on the flash is untouched. Webgui-only plugin: no daemon.
     mkdir -p first so a FRESH install (the plugin dir does not exist yet) does
     not make find exit 1 and abort the whole install (#4); the trailing || true
     keeps this block non-fatal. -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p &plgPath;
find &plgPath; -maxdepth 1 -name '*.txz' ! -name '&txz;' -delete 2>/dev/null || true
</INLINE>
</FILE>

<!--
  The package (webgui files only) is built by plugin/pkg_build.sh and attached
  to the GitHub release "v&version;". SHA256 is injected at release. upgradepkg
  installs from the cached &plgPath;/&txz; if it is already present (boot with
  no network), otherwise it downloads it from the URL first.
-->
<FILE Name="&plgPath;/&txz;" Run="/sbin/upgradepkg --install-new --reinstall">
  <URL>&pkgURL;/&txz;</URL>
  <SHA256>9f6d383e187e1ffebc3e792aca79b3d77553a7db6a3edfe3aeb56eecf94c7218</SHA256>
</FILE>

<!-- Post-install: sane read perms (a Windows/CI build can bake odd modes; the
     webgui must be able to read every page/script), then the house ceremony.
     Nothing needs restarting — the dashboard picks the tile up on next load. -->
<FILE Run="/bin/bash">
<INLINE>
chmod -R u+rwX,go+rX &emhttp; 2>/dev/null
echo ""
cat &emhttp;/banner.txt 2>/dev/null
echo ""
echo "BOMBVAULT WIDGET IS READY"
</INLINE>
</FILE>

<!-- Remove. MUST be a <FILE ... Method="remove"> block: Unraid's plugin manager
     only runs <FILE> elements, so a bare <REMOVE> tag is silently IGNORED and
     the cleanup never runs. MUST end with exit 0, or Unraid leaves the .plg on
     the flash and it reinstalls on boot. Webgui-only plugin: no daemon to stop
     — drop the exact package + files + cached .txz; keep the flash .cfg so a
     reinstall keeps the URL + token. -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
# goodbye ceremony FIRST, while the files still exist
cat &emhttp;/banner.txt 2>/dev/null
echo ""
echo "Bye!"
echo ""
pkg=$(ls /var/log/packages/ 2>/dev/null | grep -E "^&slug;(-[^-]+-[^-]+-[^-]+)?$" | head -n1)
if [ -n "$pkg" ]; then removepkg "$pkg" 2>/dev/null; fi
rm -rf &emhttp;
rm -f &plgPath;/*.txz
echo "BombVault Widget removed. Settings (flash .cfg) were kept — delete"
echo "&plgPath; manually if you don't plan to reinstall."
exit 0
</INLINE>
</FILE>

</PLUGIN>
